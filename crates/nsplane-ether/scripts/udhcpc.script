#!/bin/sh
# udhcpc hook in the guest: applies the lease to the interface and records the address.
# udhcpc sets interface, ip, mask, router, dns, lease and (when asked with -O mtu) mtu in
# the environment.
# shellcheck disable=SC2154
case "$1" in
  deconfig)
    ip -4 addr flush dev "$interface"
    ;;
  bound | renew)
    ip -4 addr flush dev "$interface"
    ip addr add "$ip/$mask" dev "$interface"
    if [ -n "${mtu:-}" ]; then
      ip link set dev "$interface" mtu "$mtu"
    fi
    if [ -n "${router:-}" ]; then
      ip route add default via "$router" dev "$interface"
    fi
    echo "DHCP lease $ip/$mask router ${router:-none} dns ${dns:-none} mtu ${mtu:-none} lease ${lease:-0}s"
    echo "$ip" >/tmp/lease
    ;;
esac
